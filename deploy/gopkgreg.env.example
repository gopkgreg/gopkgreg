# Copy to gopkgreg.env and fill in. Every gopkgregd flag can be set here as
# GOPKGREG_<FLAG NAME> (dashes become underscores). Keep this file private:
# it holds the SMTP password.

# The domain people type in "go get". Caddy serves it; the registry uses it
# as the module host, so modules are <domain>/<owner>/<module>.
GOPKGREG_DOMAIN=gopkgreg.example.com
GOPKGREG_BASE_URL=https://gopkgreg.example.com

# Email: sign-up verification, password resets, publish alerts.
GOPKGREG_SMTP_ADDR=smtp.example.com:587
GOPKGREG_SMTP_FROM=gopkgreg <no-reply@gopkgreg.example.com>
GOPKGREG_SMTP_USER=apikey
GOPKGREG_SMTP_PASSWORD=change-me

# Usernames that review reports at /admin (they must turn on two-factor).
# Register the account first, then add it here and restart.
GOPKGREG_ADMINS=
GOPKGREG_REQUIRE_2FA=true

# Daily database backups inside the data volume. Also copy them off the
# machine, together with /data/blobs.
GOPKGREG_BACKUP_DIR=/data/backups

# ---- Optional: S3-compatible storage (AWS S3, Cloudflare R2, MinIO, B2…) ----
# Module zips in a bucket instead of the data volume. Move existing zips first:
#   docker compose run --rm gopkgreg blobs copy -from /data/blobs -to "$GOPKGREG_BLOBS"
#GOPKGREG_BLOBS=s3://my-bucket/zips?region=us-east-1
#GOPKGREG_BLOBS=s3://my-bucket/zips?endpoint=https://<account>.r2.cloudflarestorage.com&region=auto
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Continuous database replication with Litestream
# (docker compose --profile litestream up -d). Uses the same credentials.
#LITESTREAM_BUCKET=my-bucket
#LITESTREAM_PATH=gopkgreg/db
#LITESTREAM_REGION=us-east-1
#LITESTREAM_ENDPOINT=              # empty for AWS; https://<account>.r2.cloudflarestorage.com for R2
